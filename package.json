{
  "name": "ciclista",
  "private": true,
  "version": "0.0.0",
  "description": "Responsive cycling commuter route analyzer and stopping optimizer.",
  "type": "module",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "build": "pnpm run build:wasm && tsc -b && vite build",
    "build:wasm": "wasm-pack build crates/ciclista-wasm --target web --out-dir ../../src/core/wasm/pkg --release && node -e \"const p='src/core/wasm/pkg/package.json',fs=require('fs');if(fs.existsSync(p)){const j=JSON.parse(fs.readFileSync(p,'utf8'));j.license='MIT';j.author='ciclista';j.repository={type:'git',url:'https://github.com/cgodoy/ciclista'};j.exports={'.':{types:'./ciclista_wasm.d.ts',import:'./ciclista_wasm.js'}};j.files=['ciclista_wasm_bg.wasm','ciclista_wasm.d.ts'];fs.writeFileSync(p,JSON.stringify(j,null,2)+'\\n');}\"",
    "dev": "vite",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "lint:css": "stylelint 'src/**/*.css'",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:snapshots": "vitest run -t snapshot"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-package-json": "^1.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.30.0",
      "js-yaml": ">=5.4.1",
      "@babel/core": ">=7.29.6",
      "brace-expansion": ">=5.0.12",
      "fast-uri": ">=3.1.8",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=7.1.6",
      "browserslist": ">=4.28.7",
      "colord": ">=2.9.4",
      "baseline-browser-mapping": ">=2.11.0",
      "source-map-js": ">=1.2.2"
    }
  }
}
